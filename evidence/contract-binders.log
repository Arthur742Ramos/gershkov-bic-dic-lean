fun {I} [Fintype I] [DecidableEq I] {T} p i y => ∏ j, p (@Subtype.val I (fun j => @Ne I j i) j) (y j)
@GGKMS.SupportPrior : {I : Type u_1} → {T : I → Type u_2} → [(i : I) → Fintype (T i)] → ((i : I) → T i → Real) → Prop
@[expose] def GGKMS.SupportPrior.{uI, uT} : {I : Type uI} →
  {T : I → Type uT} → [(i : I) → Fintype (T i)] → ((i : I) → T i → Real) → Prop :=
fun {I} {T} [(i : I) → Fintype (T i)] p =>
  And
    (∀ (i : I) (t : T i),
      @LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) (p i t))
    (∀ (i : I), @Eq Real (∑ t, p i t) (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))
