    {I : Type u_3} → [Fintype P] → [Fintype K] → [Fintype I] → (P → Real) → (I → K → Real) → (P → K → Real) → Real
@[expose] def GGKMS.energy.{uP, uK, uI} : {P : Type uP} →
  {K : Type uK} →
    {I : Type uI} → [Fintype P] → [Fintype K] → [Fintype I] → (P → Real) → (I → K → Real) → (P → K → Real) → Real :=
fun {P} {K} {I} [Fintype P] [inst_1 : Fintype K] [Fintype I] μ a q =>
  ∑ x,
    @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (μ x)
      (∑ i,
        @HPow.hPow Real Nat Real (@instHPow Real Nat (@NPow.toPow Real (@Monoid.toNPow Real Real.instMonoid)))
          (@GGKMS.value P K I inst_1 a q i x) (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
@GGKMS.Profile : {I : Type u_1} → (I → Type u_2) → Type (max u_1 u_2)
@[reducible, expose] def GGKMS.Profile.{uI, uT} : {I : Type uI} → (I → Type uT) → Type (max uI uT) :=
fun {I} T => (i : I) → T i
@GGKMS.Opponents : {I : Type u_1} → (I → Type u_2) → I → Type (max u_2 u_1)
@[reducible, expose] def GGKMS.Opponents.{uI, uT} : {I : Type uI} → (I → Type uT) → I → Type (max uT uI) :=
fun {I} T i => (j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j)
@GGKMS.pack : {I : Type u_1} →
  [DecidableEq I] → {T : I → Type u_2} → (i : I) → T i → @GGKMS.Opponents I T i → @GGKMS.Profile I T
@[expose] def GGKMS.pack.{uI, uT} : {I : Type uI} →
  [DecidableEq I] → {T : I → Type uT} → (i : I) → T i → @GGKMS.Opponents I T i → @GGKMS.Profile I T :=
fun {I} [inst : DecidableEq I] {T} i t y =>
  @DFunLike.coe
    (Equiv (Prod (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j)))
      ((j : I) → T j))
    (Prod (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j)))
    (fun x => (j : I) → T j)
    (@EquivLike.toFunLike
      (Equiv (Prod (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j)))
        ((j : I) → T j))
      (Prod (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j))) ((j : I) → T j)
      (@Equiv.instEquivLike
        (Prod (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j))) ((j : I) → T j)))
    (@Equiv.symm ((j : I) → T j)
      (Prod (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j)))
      (@Equiv.piSplitAt I inst i T))
    (@Prod.mk (T i) ((j : @Subtype I fun j => @Ne I j i) → T (@Subtype.val I (fun j => @Ne I j i) j)) t y)
@GGKMS.joint : {I : Type u_1} → [Fintype I] → {T : I → Type u_2} → ((i : I) → T i → Real) → @GGKMS.Profile I T → Real
@[expose] def GGKMS.joint.{uI, uT} : {I : Type uI} →
  [Fintype I] → {T : I → Type uT} → ((i : I) → T i → Real) → @GGKMS.Profile I T → Real :=
fun {I} [Fintype I] {T} p x => ∏ i, p i (x i)
@GGKMS.opponentMass : {I : Type u_1} →
  [Fintype I] → [DecidableEq I] → {T : I → Type u_2} → ((i : I) → T i → Real) → (i : I) → @GGKMS.Opponents I T i → Real
