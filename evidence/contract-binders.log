  [Fintype I] →
    [DecidableEq I] →
      {T : I → Type uT} →
        [(i : I) → Fintype (T i)] →
          {K : Type uK} →
            [Fintype K] →
              ((i : I) → T i → Real) → (I → K → Real) → (@GGKMS.Profile I T → K → Real) → (i : I) → T i → Real :=
fun {I} [inst : Fintype I] [inst_1 : DecidableEq I] {T} [inst_2 : (i : I) → Fintype (T i)] {K} [inst_3 : Fintype K] p a
    q i t =>
  @GGKMS.interim I inst inst_1 T inst_2 p (@GGKMS.value (@GGKMS.Profile I T) K I inst_3 a q i) i t
@GGKMS.Matches : {I : Type u_1} →
  [Fintype I] →
    [DecidableEq I] →
      {T : I → Type u_2} →
        [(i : I) → Fintype (T i)] →
          {K : Type u_3} →
            [Fintype K] →
              ((i : I) → T i → Real) →
                (I → K → Real) → (@GGKMS.Profile I T → K → Real) → (@GGKMS.Profile I T → K → Real) → Prop
@[expose] def GGKMS.Matches.{uI, uT, uK} : {I : Type uI} →
  [Fintype I] →
    [DecidableEq I] →
      {T : I → Type uT} →
        [(i : I) → Fintype (T i)] →
          {K : Type uK} →
            [Fintype K] →
              ((i : I) → T i → Real) →
                (I → K → Real) → (@GGKMS.Profile I T → K → Real) → (@GGKMS.Profile I T → K → Real) → Prop :=
fun {I} [inst : Fintype I] [inst_1 : DecidableEq I] {T} [inst_2 : (i : I) → Fintype (T i)] {K} [inst_3 : Fintype K] p a
    q q₀ =>
  And (@GGKMS.Feasible (@GGKMS.Profile I T) K inst_3 q)
    (And
      (∀ (i : I) (t : T i),
        @Eq Real (@GGKMS.slope I inst inst_1 T inst_2 K inst_3 p a q i t)
          (@GGKMS.slope I inst inst_1 T inst_2 K inst_3 p a q₀ i t))
      (∀ (k : K),
        @Eq Real (@GGKMS.exAnte I inst inst_1 T inst_2 p fun x => q x k)
          (@GGKMS.exAnte I inst inst_1 T inst_2 p fun x => q₀ x k)))
